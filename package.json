{
  "name": "env-doctor",
  "version": "0.1.0",
  "description": "Static environment variable and contract linter for Node.js and TypeScript projects",
  "type": "module",
  "bin": {
    "env-doctor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.12"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
